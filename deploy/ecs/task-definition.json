{
  "family": "upbit-scraper",
  "requiresCompatibilities": [
    "FARGATE"
  ],
  "networkMode": "awsvpc",
  "cpu": "256",
  "memory": "512",
  "runtimePlatform": {
    "cpuArchitecture": "X86_64",
    "operatingSystemFamily": "LINUX"
  },
  "executionRoleArn": "__EXECUTION_ROLE_ARN__",
  "containerDefinitions": [
    {
      "name": "upbit-scraper",
      "image": "__AWS_ACCOUNT_ID__.dkr.ecr.__AWS_REGION__.amazonaws.com/__REPOSITORY_NAME__:__IMAGE_TAG__",
      "essential": true,
      "stopTimeout": 30,
      "linuxParameters": {
        "initProcessEnabled": true
      },
      "healthCheck": {
        "command": [
          "CMD-SHELL",
          "python -m src.support.poll_healthcheck"
        ],
        "interval": 15,
        "timeout": 5,
        "retries": 3,
        "startPeriod": 60
      },
      "environment": [
        {
          "name": "TRADING_ENABLED",
          "value": "false"
        },
        {
          "name": "TRADE_ENVIRONMENT",
          "value": "DEMO"
        },
        {
          "name": "LOG_LEVEL",
          "value": "INFO"
        },
        {
          "name": "SCRAPER_URL",
          "value": "https://api-manager.upbit.com/api/v1/announcements/search"
        },
        {
          "name": "SCRAPER_SEARCH_TERM",
          "value": "(KRW Market)"
        },
        {
          "name": "SCRAPER_COOLDOWN",
          "value": "10"
        },
        {
          "name": "SCRAPER_COOLDOWN_OFFSET",
          "value": "2.5"
        },
        {
          "name": "SCRAPER_TIMEOUT",
          "value": "5"
        },
        {
          "name": "POLL_HEALTHCHECK_GRACE_SECONDS",
          "value": "15"
        },
        {
          "name": "ORDER_DIRECTION",
          "value": "BUY"
        },
        {
          "name": "ORDER_QUANTITY",
          "value": "0"
        },
        {
          "name": "ORDER_CALLBACK_RATE",
          "value": "5"
        },
        {
          "name": "BINANCE_SYMBOL_QUOTE_ASSET",
          "value": "USDT"
        },
        {
          "name": "NOTICE_SYMBOL_PATTERN",
          "value": ""
        }
      ],
      "secrets": [
        {
          "name": "BINANCE_API_KEY",
          "valueFrom": "__SECRET_ARN__:BINANCE_API_KEY::"
        },
        {
          "name": "BINANCE_API_SECRET",
          "valueFrom": "__SECRET_ARN__:BINANCE_API_SECRET::"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "__LOG_GROUP_NAME__",
          "awslogs-region": "__AWS_REGION__",
          "awslogs-stream-prefix": "worker"
        }
      }
    }
  ],
  "tags": [
    {
      "key": "Project",
      "value": "upbit-scraper"
    },
    {
      "key": "Environment",
      "value": "demo"
    }
  ]
}
